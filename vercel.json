{
  "framework": "vite",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/landing", "destination": "/landing.html" },
    { "source": "/landing.html", "destination": "/landing.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}