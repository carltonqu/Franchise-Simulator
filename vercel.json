{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/vite.svg", "dest": "/vite.svg" },
    { "src": "/landing.html", "dest": "/landing.html" },
    { "src": "/onboarding.html", "dest": "/onboarding.html" },
    { "src": "/onboarding-2.html", "dest": "/onboarding-2.html" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/app/(.*)", "dest": "/index.html" },
    { "src": "/login", "dest": "/index.html" },
    { "src": "/register", "dest": "/index.html" },
    { "src": "/verify-email", "dest": "/index.html" },
    { "src": "/results", "dest": "/index.html" },
    { "src": "/results/(.*)", "dest": "/index.html" },
    { "src": "/history", "dest": "/index.html" },
    { "src": "/", "dest": "/landing.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}
