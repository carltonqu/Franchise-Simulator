# Server Configuration
PORT=8787
JWT_SECRET=your-jwt-secret-key-here
FRONTEND_URL=http://localhost:5174

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Email Configuration (Choose one)

# Option 1: Resend (Recommended for production)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxx

# Option 3: Gmail (for testing)
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# Option 4: Ethereal (for development testing)
# ETHEREAL_USER=xxxxxx@ethereal.email
# ETHEREAL_PASS=xxxxxxxx

# Email Settings
FROM_EMAIL=noreply@franchisesimulator.com
APP_NAME=Franchise Simulator

# Stripe (Optional - for payments)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx

# Anthropic (Optional - for AI reports)
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_MODEL=claude-sonnet-4-5
